# =============================================================
# PLANTILLA DE CONFIGURACIÓN — Copiar como .env y rellenar
# NUNCA subir el .env real a git (está en .gitignore)
# =============================================================

# --- PUERTOS (ajustar si hay conflicto en el servidor) -------
FRONTEND_PORT=80
BACKEND_PORT=8082

# --- BASE DE DATOS PRINCIPAL (tienda_db) ---------------------
DB_USERNAME=root
DB_PASSWORD=CAMBIA_ESTO_por_password_seguro

# --- BASE DE DATOS USUARIOS (tienda_usuarios) ----------------
DB_USUARIOS_PASSWORD=CAMBIA_ESTO_por_password_seguro

# --- JWT (mínimo 32 caracteres, aleatorio) -------------------
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_genera_con_openssl_rand_hex_32

# --- EMAIL (Gmail con App Password) --------------------------
# Guía: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# --- GOOGLE OAUTH2 -------------------------------------------
# Crear en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# --- REVOLUT (pasarela de pago principal) --------------------
# Obtener en: https://merchant.revolut.com/api
REVOLUT_API_KEY=sk_xxxx

# --- PAYPAL (pasarela alternativa) ---------------------------
# Obtener en: https://developer.paypal.com
PAYPAL_CLIENT_ID=xxxx
PAYPAL_CLIENT_SECRET=xxxx
PAYPAL_MODE=live
# PAYPAL_MODE=sandbox  (para pruebas)

# --- AMAZON SP-API -------------------------------------------
# Guía: https://developer-docs.amazon.com/sp-api/
AMAZON_CLIENT_ID=amzn1.application-oa2-client.xxxx
AMAZON_CLIENT_SECRET=xxxx
AMAZON_REFRESH_TOKEN=Atzr|xxxx
AMAZON_ACCESS_KEY=xxxx
AMAZON_SECRET_KEY=xxxx
AMAZON_MARKETPLACE_ID=A1RKKUPIHCS9HS

# --- PROVEEDORES ---------------------------------------------
NOVAENGEL_USER=tu_usuario_novaengel
NOVAENGEL_PASSWORD=tu_password_novaengel
BTS_API_JWT=tu_jwt_bts

# --- IDEALO --------------------------------------------------
# Obtener en: https://www.idealo.es/price-comparison/seller-api
IDEALO_CLIENT_ID=xxxx
IDEALO_CLIENT_SECRET=xxxx
IDEALO_SHOP_ID=xxxx

# --- FRONTEND (Vite) -----------------------------------------
VITE_API_URL=/api
VITE_GA_ID=G-XXXXXXXXXX
VITE_PAYPAL_CLIENT_ID=xxxx

# --- URLs ----------------------------------------------------
FRONTEND_URL=https://erosyafrodita.com

# --- TRAEFIK (Let's Encrypt HTTPS) ---------------------------
# Email para notificaciones de certificado
ACME_EMAIL=admin@erosyafrodita.com
DOMAIN=erosyafrodita.com
